# @DKMS_NAME@ @VER@ — DKMS build of the open GPU kernel modules with PCIe P2P + 48G-4090 support.
# Drop-in for the CUDA-repo nvidia-kernel-open-dkms. This is the *processed* dkms.conf; the tree's
# kernel-open/dkms.conf is an nvidia-installer template (__VERSION_STRING/__DKMS_MODULES) that DKMS
# cannot consume. Every other build-glue file is identical to the stock package.
PACKAGE_NAME="@DKMS_NAME@"
PACKAGE_VERSION="@VER@"
AUTOINSTALL=yes

MAKE[0]="'make' ${parallel_jobs+-j$parallel_jobs} KERNEL_UNAME=${kernelver} IGNORE_PREEMPT_RT_PRESENCE=1 IGNORE_XEN_PRESENCE=1 modules"

BUILT_MODULE_NAME[0]="nvidia"
BUILT_MODULE_LOCATION[0]="kernel-open"
DEST_MODULE_LOCATION[0]="/updates/dkms"

BUILT_MODULE_NAME[1]="nvidia-modeset"
BUILT_MODULE_LOCATION[1]="kernel-open"
DEST_MODULE_LOCATION[1]="/updates/dkms"

BUILT_MODULE_NAME[2]="nvidia-drm"
BUILT_MODULE_LOCATION[2]="kernel-open"
DEST_MODULE_LOCATION[2]="/updates/dkms"

BUILT_MODULE_NAME[3]="nvidia-peermem"
BUILT_MODULE_LOCATION[3]="kernel-open"
DEST_MODULE_LOCATION[3]="/updates/dkms"

BUILT_MODULE_NAME[4]="nvidia-uvm"
BUILT_MODULE_LOCATION[4]="kernel-open"
DEST_MODULE_LOCATION[4]="/updates/dkms"
